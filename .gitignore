# Local toolchain and large binaries (Joern / JDK, ~4.2 GB) — see docs section 9
tools/

# Runtime artifacts: SQLite db, CPG binaries, Joern workspace, unpacked uploads
demo/data/

# Screenshots / recordings are local artifacts
demo/shots/
# lint reports emitted next to screenshots by the shoot tool
*-report.json

# Third-party sample: SpringBlade is large; fetch it with demo/scripts/fetch_springblade.py
demo/samples/springblade/

# Common ignores
**/__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.memsearch/
.DS_Store
Thumbs.db
node_modules/
*.log
.idea/
.vscode/

demo/backend/server.log*
